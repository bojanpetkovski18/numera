# Copy to .env and replace the placeholders. Never commit .env.
POSTGRES_DB=numera
POSTGRES_USER=numera
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# API settings when running the API with dotnet run (read by the .NET API, not by Docker Compose). Set as environment variables.
# Jwt__SigningKey must be at least 32 characters. Generate one, for example: openssl rand -base64 48
Jwt__SigningKey=replace-with-a-random-string-of-at-least-32-characters
ConnectionStrings__Numera=Host=localhost;Port=5432;Database=numera;Username=numera;Password=change-me

# Full stack in Docker (docker compose up --build). The API container reads these.
# JWT_SIGNING_KEY must be at least 32 characters. Generate one, for example: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-characters
# Port of the web app on your machine: http://localhost:8080
WEB_PORT=8080